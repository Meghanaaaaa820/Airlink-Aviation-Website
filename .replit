modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ENQUIRY_CC_EMAIL = "info@airlinkaviation.in"
ENQUIRY_TO_EMAIL = "sales@airlinkaviation.in"
TITAN_SMTP_HOST = "smtp.titan.email"
TITAN_SMTP_PORT = "465"
TITAN_SMTP_SECURE = "true"
TITAN_SMTP_USER = "sales@airlinkaviation.in"
